<mxfile host="drawio" modified="2026-10-31" version="24.0.0" type="device">
  <diagram id="spire-ocp-topology" name="SPIRE on OpenShift 部署拓扑">
    <mxGraphModel dx="1422" dy="762" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- OpenShift Cluster boundary -->
        <mxCell id="cluster" value="OpenShift Cluster — cluster-vtmrn (OCP 4.22)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#FF8800;strokeWidth=3;dashed=1;fontSize=15;fontStyle=1;verticalAlign=top;arcSize=2;" vertex="1" parent="1">
          <mxGeometry x="10" y="10" width="1440" height="950" as="geometry" />
        </mxCell>

        <!-- SPIRE Namespace -->
        <mxCell id="spire-ns" value="Namespace: zero-trust-workload-identity-manager" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;fontStyle=1;verticalAlign=top;arcSize=3;" vertex="1" parent="1">
          <mxGeometry x="40" y="60" width="860" height="240" as="geometry" />
        </mxCell>

        <mxCell id="operator-box" value="ZeroTrustWorkloadIdentityManager&#xa;Operator Controller Manager&#xa;(Deployment)&#xa;&#xa;职责：管理所有 SPIRE 组件生命周期" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="60" y="120" width="220" height="140" as="geometry" />
        </mxCell>

        <mxCell id="server-box" value="SpireServer&#xa;(StatefulSet, 1 replica)&#xa;■ PVC 2Gi (sqlite3)&#xa;&#xa;职责：签发 SVID，维护信任域&#xa;暴露 bundle endpoint" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="310" y="120" width="220" height="140" as="geometry" />
        </mxCell>

        <mxCell id="oidc-box" value="SpireOIDCDiscoveryProvider&#xa;(Deployment, 1 replica)&#xa;→ OCP Route (managedRoute)&#xa;&#xa;职责：发布 OIDC 端点&#xa;用于验证 JWT-SVID" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="560" y="120" width="220" height="140" as="geometry" />
        </mxCell>

        <!-- External JWT client -->
        <mxCell id="ext-jwt" value="JWT 验证方&#xa;（REST API / 浏览器）" style="ellipse;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="810" y="60" width="180" height="80" as="geometry" />
        </mxCell>

        <!-- Control Plane Nodes -->
        <mxCell id="master-bg" value="Control Plane Nodes ×3 (master + worker roles)&#xa;每个节点上都有 DaemonSet Pod" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;fontStyle=1;verticalAlign=top;arcSize=3;" vertex="1" parent="1">
          <mxGeometry x="40" y="340" width="580" height="200" as="geometry" />
        </mxCell>

        <mxCell id="agent-master" value="SpireAgent Pod&#xa;(DaemonSet)&#xa;Unix socket:&#xa;/tmp/spire-agent/&#xa;职责：节点认证 + 向 Pod&#xa;提供 Workload API" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="70" y="400" width="190" height="110" as="geometry" />
        </mxCell>

        <mxCell id="csi-master" value="SpiffeCSIDriver Pod&#xa;(DaemonSet)&#xa;driver: csi.spiffe.io&#xa;职责：将 SVID 原地&#xa;挂载到 Pod volume&#xa;（无需重启 Pod 轮换）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="300" y="400" width="190" height="110" as="geometry" />
        </mxCell>

        <!-- Worker Nodes -->
        <mxCell id="worker-bg" value="Worker Nodes ×2&#xa;每个节点上都有 DaemonSet Pod" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;fontStyle=1;verticalAlign=top;arcSize=3;" vertex="1" parent="1">
          <mxGeometry x="660" y="340" width="580" height="200" as="geometry" />
        </mxCell>

        <mxCell id="agent-worker" value="SpireAgent Pod&#xa;(DaemonSet)&#xa;Unix socket:&#xa;/tmp/spire-agent/&#xa;职责：节点认证 + 向 Pod&#xa;提供 Workload API" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="690" y="400" width="190" height="110" as="geometry" />
        </mxCell>

        <mxCell id="csi-worker" value="SpiffeCSIDriver Pod&#xa;(DaemonSet)&#xa;driver: csi.spiffe.io&#xa;职责：将 SVID 原地&#xa;挂载到 Pod volume&#xa;（无需重启 Pod 轮换）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="920" y="400" width="190" height="110" as="geometry" />
        </mxCell>

        <!-- User Namespace -->
        <mxCell id="user-ns" value="Namespace: userN-spire-lab (×10 参与者命名空间)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;fontStyle=1;verticalAlign=top;arcSize=3;" vertex="1" parent="1">
          <mxGeometry x="40" y="590" width="680" height="180" as="geometry" />
        </mxCell>

        <mxCell id="pod-a" value="service-a Pod&#xa;vol: /run/spiffe/tls/&#xa;  tls.crt (X.509-SVID)&#xa;  tls.key (内存生成)&#xa;  bundle.crt" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="70" y="650" width="200" height="100" as="geometry" />
        </mxCell>

        <mxCell id="pod-b" value="service-b Pod&#xa;vol: /run/spiffe/tls/&#xa;  tls.crt (X.509-SVID)&#xa;  tls.key (内存生成)&#xa;  bundle.crt" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="380" y="650" width="200" height="100" as="geometry" />
        </mxCell>

        <!-- Peer demo namespace -->
        <mxCell id="peer-ns" value="Namespace: peer-demo-spire-lab（负向控制，无 ClusterSPIFFEID 注册条目）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;fontStyle=1;verticalAlign=top;arcSize=3;" vertex="1" parent="1">
          <mxGeometry x="780" y="590" width="560" height="180" as="geometry" />
        </mxCell>

        <mxCell id="peer-pod" value="peer Pod&#xa;无 SVID&#xa;（无注册条目 →&#xa; Agent 拒绝颁发）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="980" y="650" width="170" height="90" as="geometry" />
        </mxCell>

        <!-- EDGES -->

        <mxCell id="e1" value="① Node Attestation&#xa;gRPC / k8s_psat" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#82b366;strokeWidth=2;fontSize=10;fontColor=#333;" edge="1" source="agent-master" target="server-box" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e1b" value="① Node Attestation&#xa;gRPC / k8s_psat" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#82b366;strokeWidth=2;fontSize=10;fontColor=#333;" edge="1" source="agent-worker" target="server-box" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e2" value="② SVID 申请&#xa;Unix socket" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#6c8ebf;strokeWidth=2;fontSize=10;" edge="1" source="csi-master" target="agent-master" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e3" value="③ SVID 原地挂载&#xa;(CSI volume)" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#d6b656;strokeWidth=2;fontSize=10;" edge="1" source="csi-master" target="pod-a" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e3b" value="③ SVID 原地挂载&#xa;(CSI volume)" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#d6b656;strokeWidth=2;fontSize=10;" edge="1" source="csi-worker" target="pod-b" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e4" value="④ mTLS (✓ 双向证书验证)" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#009900;strokeWidth=3;fontSize=11;fontColor=#009900;endArrow=block;startArrow=block;startFill=1;endFill=1;" edge="1" source="pod-a" target="pod-b" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e5" value="⑤ TLS 握手失败 ✗&#xa;（无有效 SVID）" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#b85450;strokeWidth=2;dashed=1;fontSize=10;fontColor=#b85450;" edge="1" source="peer-pod" target="pod-b" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e6" value="⑥ JWT-SVID 验证&#xa;OIDC Discovery" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#9673a6;strokeWidth=2;fontSize=10;" edge="1" source="ext-jwt" target="oidc-box" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
